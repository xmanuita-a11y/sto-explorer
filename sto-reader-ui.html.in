<!doctype html>
<html lang="it"><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'none'; base-uri 'none'; form-action 'none'"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>STO Reader 0.4 — valori e confronto offline</title>
<style>
:root{color-scheme:dark;font:15px system-ui,sans-serif;background:#101722;color:#e7edf5}*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0}main{max-width:1480px;margin:auto;padding:32px 24px}h1{font-size:36px;margin:10px 0}p{color:#adbcd0;line-height:1.6}.eyebrow{color:#66d8c4;font-size:12px;letter-spacing:2px}.files{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:26px 0}.card{background:#192433;border:1px solid #344559;border-radius:12px;padding:22px;min-width:0}h2{font-size:18px;margin-top:0}button,.picker{display:inline-block;background:#244d61;color:white;border:1px solid #498097;border-radius:7px;padding:10px 15px;cursor:pointer;font:inherit}button:hover,.picker:hover{background:#32647a}.picker input{display:block;margin-top:10px;max-width:100%;font:inherit}.meta{white-space:pre-wrap;overflow-wrap:anywhere;font-size:14px;line-height:1.7;margin-top:16px}.error{color:#ffadb5}.notice{padding:13px 16px;border-left:3px solid #e8bb6e;background:#332c22;margin:18px 0;white-space:pre-wrap}.toolbar{display:flex;gap:16px;align-items:end;flex-wrap:wrap;margin:24px 0 14px}input[type=search]{background:#192433;color:white;border:1px solid #53657b;padding:12px;border-radius:7px;min-width:240px;font:inherit}input[type=checkbox]{accent-color:#66d8c4;width:18px;height:18px;vertical-align:middle}.stats{color:#b9c9da;margin:14px 0}.tablebox{overflow:auto;border:1px solid #344559;border-radius:10px}table{border-collapse:collapse;width:100%;font-size:14px}th{text-align:left;background:#223145;color:#d9e5f2;padding:14px;position:sticky;top:0}td{padding:12px 14px;border-top:1px solid #2b3a4d}td.value{font-variant-numeric:tabular-nums}.changed{background:#3d3220}.only-a,.only-b{background:#203648}.badge{font-size:12px;color:#f2d39b}.same .badge{color:#97b6ac}.single .badge{color:#adbcd0}.empty{text-align:center;padding:40px;color:#adbcd0}details{margin:20px 0}summary{cursor:pointer;color:#b9c9da}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#192433;padding:16px;border-radius:8px;font-size:13px}footer{margin-top:28px;font-size:12px;color:#90a3b9;line-height:1.7}button:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid #66d8c4;outline-offset:3px}@media(max-width:700px){.files{grid-template-columns:1fr}main{padding:22px 14px}h1{font-size:28px}}
main{max-width:1480px}.tablebox{max-height:72vh}table{min-width:900px}td.parameter{width:34%}.primary{font-size:16px;font-weight:600;line-height:1.45}.secondary{font-size:11px;color:#afc1d2;margin-top:5px}.technical{font:11px ui-monospace,monospace;color:#93adc4;margin-top:6px;overflow-wrap:anywhere;line-height:1.6}.group-row td{background:#162a3c;color:#75ddc9;font-weight:600;padding:11px 14px}.changed td:first-child{border-left:3px solid #e8bb6e}.only-a td:first-child,.only-b td:first-child{border-left:3px solid #74bfe8}.control{display:flex;flex-direction:column;gap:7px;font-size:12px;color:#b2c5d7}select{background:#192433;color:#e7edf5;border:1px solid #53657b;padding:11px;border-radius:7px;font:inherit;max-width:250px}.checks{display:flex;gap:16px;align-items:center;flex-wrap:wrap}.help{font-size:12px;line-height:1.7;color:#99b2c9;margin:18px 0}.quiet{background:transparent;padding:7px 12px;font-size:13px}button:disabled{opacity:.45;cursor:default}.originals-off .technical{display:none}.card.drag{border-color:#66d8c4;background:#23424a}.drop-hint{font-size:12px;color:#99b2c9;margin-top:12px}th{z-index:1}.meta{min-height:48px}select:focus-visible{outline:3px solid #66d8c4;outline-offset:3px}.legend{color:#afc5d8;font-size:12px;margin:12px 0}.badge{white-space:normal}
.overview{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:24px 0}.panel{border:1px solid #344559;background:#142030;border-radius:12px;padding:20px}.panel h2{font-size:17px;margin:0 0 15px}.summary-title{font-size:21px;font-weight:600;color:#e6edf5;line-height:1.4}.summary-detail{color:#acc0d3;font-size:13px;white-space:pre-wrap;line-height:1.8;margin-top:12px}.areas{display:flex;flex-wrap:wrap;gap:7px;margin-top:16px}.area-button{padding:6px 9px;font-size:12px;background:#223346;border-color:#40556c}.area-button.active{border-color:#71ddc9;color:#71ddc9}.wheels{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}.wheel{background:#1b2d40;border:1px solid #38516b;border-radius:9px;padding:12px;min-height:88px}.wheel-label{color:#adc4d8;font-size:12px}.wheel-value{font-size:15px;margin-top:7px;font-variant-numeric:tabular-nums}.wheel-diff{border-color:#ddad62;background:#302a21}.wheel-hint{font-size:11px;color:#a9c1d5;line-height:1.5;margin-top:6px}.export-note{font-size:12px;color:#a9c1d5;margin:12px 0}.boot-error{padding:18px;background:#40232d;color:#ffdce0;border:1px solid #9b5b6c;border-radius:10px;margin:20px 0}details{border:1px solid #30465c;border-radius:8px;padding:14px}button,input,select{touch-action:manipulation}h1{letter-spacing:-1px}.notes-section{white-space:pre-wrap}.print-heading{display:none}@media(max-width:800px){.overview{grid-template-columns:1fr}.toolbar{gap:12px}.control{flex:1;min-width:200px}select{max-width:100%}}@media print{:root{color-scheme:light;background:white;color:#111;font-size:10pt}main{max-width:none;padding:0}.files,.toolbar,.checks,.help,.export-note,.drop-hint,.areas,.boot-error,footer,details,.overview select{display:none!important}.overview{display:block}.panel{background:white;color:#111;border:0;padding:5px}.panel h2{color:#111}.summary-title,.summary-detail,.stats,.legend,.primary,.secondary,.technical{color:#111}.wheels{grid-template-columns:1fr 1fr}.wheel{background:white;border:1px solid #888}.wheel-label,.wheel-value,.wheel-hint{color:#111}.tablebox{overflow:visible;max-height:none;border:0}table{min-width:0;width:100%;font-size:9pt}th{position:static;background:#ddd;color:#111}td,th{padding:6px}.group-row td{background:#e8e8e8;color:#111}.changed,.only-a,.only-b{background:#fff6e1}.badge{color:#111!important}.primary{font-size:10pt}.technical,.secondary{font-size:8pt}tr{break-inside:avoid}thead{display:table-header-group}.notice{background:white;color:#111}.print-heading{display:block;white-space:pre-wrap;font-size:10pt}h1{font-size:20pt}.eyebrow{color:#111}}

</style>
<style>
/* Modern garage shell from the two user-supplied Camry screenshots.
   Appearance only: field association and conversion evidence remain separate. */
:root{color-scheme:dark;background:#121318;color:#efeff3;font-family:Arial,Helvetica,sans-serif}main{max-width:1860px;padding:18px 24px}.garage-window{position:relative;margin:0 auto 22px;min-height:820px;background:linear-gradient(#272830,#1b1c24);border:1px solid #34353f;border-radius:15px;padding:0 22px 0;box-shadow:0 16px 60px #0006;color:#f1f1f4;color-scheme:dark;--sidebar:330px}
.garage-tools{margin:0;border:0;background:none}.garage-title{display:flex;align-items:center;gap:10px;min-height:48px;font-size:21px;font-weight:700;letter-spacing:0}.garage-title .garage-wrench{font-size:27px;color:#e8e8ed;line-height:1}.garage-title strong{color:#ffcd00}.garage-file-name{font-size:19px;font-weight:700;overflow-wrap:anywhere}.garage-title #garage-source{margin-left:auto;max-width:28%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;color:#9b9da9;font-weight:400}
.garage-tabs{display:flex;gap:0;padding:0;border:1px solid #363741;border-radius:9px 9px 0 0;height:39px;background:#272830}.garage-tabs button{min-width:124px;border:0;border-bottom:2px solid transparent;border-radius:0;background:none;color:#e9e9ef;padding:7px 20px;font:bold 18px Arial;text-transform:uppercase}.garage-tabs button[aria-pressed=true]{border-bottom-color:#0875ed;background:linear-gradient(transparent,#ffffff03)}.garage-tabs button:hover{background:#31323d}.garage-caption{font:11px Arial;color:#9799a7;margin-right:calc(var(--sidebar) + 30px);padding:9px 8px 4px;min-height:27px;line-height:1.35}
.garage-actions{position:absolute;right:22px;top:112px;bottom:108px;width:var(--sidebar);display:flex;flex-direction:column;justify-content:flex-end;gap:9px;overflow:auto;padding:0;background:none;border:0}.garage-action-panel{border:0;border-radius:12px;padding:16px;background:#292a335e}.garage-action-panel h3{font:bold 14px Arial;color:#ffcc00;margin:0 0 8px}.garage-action-buttons{display:flex;flex-direction:column;gap:5px}.garage-action-buttons button,.garage-action-panel>button{background:linear-gradient(#34353f,#2c2d36);color:#ededf2;border:1px solid #3b3c46;border-radius:8px;padding:5px 10px;min-height:29px;font:14px Arial;text-align:left}.garage-action-buttons button:hover{background:#3d3f4b}.garage-actions button:disabled{opacity:.5;cursor:default}.garage-action-buttons button.primary-load{background:#33343e;color:#fff;border-color:#464854;font-weight:600}.garage-actions .garage-file-row{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:5px}.garage-actions .garage-file-row button{text-align:center;padding:5px 4px;font-size:12px}.garage-actions .garage-pref button{background:none;border:0;padding:3px 0;min-height:25px;font-size:14px}.garage-actions .garage-more{margin:0;padding:0;border:0;background:none}.garage-more>summary{font-size:12px;color:#aaaebb;padding:6px 0}.garage-more .garage-action-buttons{padding-top:6px}.garage-tech{display:flex;gap:12px;align-items:center}.garage-tech-symbol{display:grid;place-items:center;width:44px;height:44px;border:1px solid #626572;border-radius:12px;font-size:24px;color:#9599aa}.garage-tech small{display:block;color:#ffcc00;font-size:10px}.garage-tech b{font-size:19px}.garage-sidebar-bottom{display:grid;grid-template-columns:1fr 1fr;gap:6px}.garage-sidebar-bottom button{border:1px solid #3b3c46;background:#2b2c35;border-radius:8px;padding:6px;color:#ccc;font:14px Arial}
.garage-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-content:start;align-items:start;gap:14px 22px;max-width:720px;margin:0 calc(var(--sidebar) + 40px) 0 auto;padding:7px 16px 30px 0;min-height:520px;height:calc(100vh - 245px);overflow:auto;border:0;background:none;color:#ededf3;scrollbar-color:#666873 transparent;scrollbar-width:thin}.garage-card{min-width:0;overflow:visible;border:0;border-radius:0;background:none}.garage-card.wide{grid-column:1/-1}.garage-lf,.garage-lr{grid-column:1}.garage-rf,.garage-rr{grid-column:2}.garage-card h2{margin:0 0 7px;padding:5px 8px;background:#292a3359;color:#ffcc00;font:bold 13px Arial;letter-spacing:0;text-transform:uppercase;border:0;border-radius:0}.garage-card h2::after{content:':'}.garage-entry{position:relative;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr) 15px;align-items:center;gap:0 5px;min-height:24px;padding:2px 0;border:0;font:14px Arial;line-height:1.3;overflow-wrap:anywhere}.garage-label{text-align:right;font-weight:400}.garage-values{display:grid;grid-template-columns:repeat(auto-fit,minmax(0,1fr));gap:7px;min-width:0}.garage-value{display:flex;align-items:center;gap:4px;flex-wrap:wrap;min-width:0;background:none;padding:0}.garage-value .primary{font:bold 13px ui-monospace,Consolas,'Courier New',monospace;line-height:1.3;color:#f0f1f6;background:none;border:0;box-shadow:none;padding:0;min-width:0;overflow-wrap:anywhere}.garage-side{display:none}.garage-internal{font:9px Arial;color:#9598aa}.garage-entry.changed{background:#6b522633;border-left:2px solid #b38e3a}.garage-entry.only-a,.garage-entry.only-b{background:#18507933;border-left:2px solid #3278a5}.garage-status{grid-column:2;font:10px Arial;color:#cfb981}.garage-columns{display:grid;grid-template-columns:1.35fr .5fr .5fr 15px;gap:5px;padding:3px 0;color:#9da1b0;font-size:10px}.garage-columns>div:first-child{text-align:right}.garage-output{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr) 15px;gap:5px;padding:2px 0;font:14px Arial;min-height:24px}.garage-unavailable{color:#9195a5;font:13px ui-monospace,Consolas,monospace}.garage-details{display:block;grid-column:1/-1;border:0;margin:0;padding:0}.garage-details>summary{position:absolute;right:0;top:5px;width:13px;line-height:13px;list-style:none;text-align:center;border:1px solid #555762;border-radius:50%;font:bold 9px Arial;color:#a9adbd;background:none;cursor:pointer;opacity:.65}.garage-details>summary::-webkit-details-marker{display:none}.garage-details[open]>summary{color:white;border-color:#0875ed;opacity:1}.garage-details>div,.garage-details>.field-help{margin:0;padding:5px 7px;background:#2e303b;color:#aeb5c7;font-size:11px;line-height:1.5}.garage-details>.field-help{border:0;border-radius:0}.garage-details .field-help summary{font-size:11px;color:#b7c5dc}.garage-details .help{color:#b7c0d1;margin:5px 0}.garage-grid .empty{grid-column:1/-1;color:#a3a6b5;padding:70px 18px;font-size:14px}.garage-rear{justify-self:center;width:calc(50% - 11px)}.garage-cockpit,.garage-other{grid-column:1/-1}.garage-page-all .garage-front,.garage-page-chassis .garage-front{grid-row:1;grid-column:1}.garage-page-all .garage-front-arb,.garage-page-chassis .garage-front-arb{grid-row:1;grid-column:2}.garage-page-all .garage-lf,.garage-page-chassis .garage-lf{grid-row:2}.garage-page-all .garage-rf,.garage-page-chassis .garage-rf{grid-row:2}.garage-page-all .garage-lr,.garage-page-chassis .garage-lr{grid-row:3}.garage-page-all .garage-rr,.garage-page-chassis .garage-rr{grid-row:3}.garage-page-all .garage-rear,.garage-page-chassis .garage-rear{grid-row:4;grid-column:1/-1}.garage-page-tires .garage-lf,.garage-page-tires .garage-rf{grid-row:1}.garage-page-tires .garage-lr,.garage-page-tires .garage-rr{grid-row:2}
.garage-notes{margin:0 calc(var(--sidebar) + 40px) 0 0;padding:16px 25px;min-height:520px;height:calc(100vh - 245px);overflow:auto}.garage-notes h2{font-size:14px;color:#ffcc00}.garage-notes pre{font:14px/1.7 ui-monospace,Consolas,monospace;background:#242630;border:1px solid #373945;white-space:pre-wrap;overflow-wrap:anywhere}.garage-bottom{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 15px;margin:0 0 20px;border:1px solid #32333d;border-radius:10px;background:#191a22}.garage-bop{display:flex;gap:8px;flex-wrap:wrap}.garage-bop-item{width:260px}.garage-bop-item span{font-size:13px;color:#8e93a3;display:block;margin:0 0 4px}.garage-bop-item button{width:100%;display:flex;justify-content:space-between;padding:4px 9px;background:#23242c;border:1px solid #363741;border-radius:9px;color:#c9ccd7;font:13px ui-monospace,monospace}.garage-apply{width:var(--sidebar);padding:12px;border:0;border-radius:7px;background:#075bcc;color:white;font:bold 17px Arial}.garage-apply:disabled{opacity:.5}.garage-readonly{font:10px Arial;color:#8a90a0;margin-top:5px}.garage-alert{color:#ffc6c6;background:#592a324d;padding:10px;font-size:12px;white-space:pre-wrap}.garage-window button:focus-visible,.garage-window summary:focus-visible{outline:2px solid #1785ff;outline-offset:2px}.reader-drawer{border:1px solid #363a47;border-radius:7px;padding:13px;margin-top:22px}.reader-drawer>summary{font-size:13px}.reader-drawer h1{font-size:24px}.scope-note{font-size:12px;color:#aeb7c8;line-height:1.5;border-left:2px solid #727f94;padding:8px 12px;background:#1b2330}.garage-mode .files{margin:14px 0;gap:12px}.garage-mode .files .card{padding:12px}.garage-mode .toolbar{gap:10px;margin:12px 0}.garage-mode .control{font-size:11px}.garage-mode select{padding:6px}.garage-mode .stats{font-size:12px}.garage-mode .meta{font-size:11px}.garage-sdk .garage-card h2::after{content:none}.sdk-entry .primary{white-space:pre-wrap}.sdk-control-spin{display:grid;grid-template-columns:18px minmax(0,1fr) 18px;gap:5px}.sdk-control-drop{display:grid;grid-template-columns:18px minmax(0,1fr);gap:5px}.garage-sdk .sdk-arrow{display:grid;place-items:center;width:18px;height:23px;min-height:0;margin:0;padding:0;border:1px solid #3b3d49;border-radius:8px;background:#ffffff02;color:#e1e3eb;font:23px/18px Arial;opacity:.7;cursor:default}.garage-sdk .sdk-control-drop .sdk-arrow{border-color:transparent;background:none;font-size:19px}.garage-sdk input[type=checkbox]{width:15px;height:15px;accent-color:#096ae8;margin:0;opacity:.8}.garage-grid.comparing{max-width:860px}.garage-native .sto-native-surface{font-family:Arial,sans-serif}.garage-native .sto-native-label{font-weight:400}.garage-native .sto-native-value{font-family:ui-monospace,Consolas,monospace;font-weight:bold}
.garage-title strong{margin-right:5px}.garage-wrench svg{width:26px;height:26px;display:block}
/* Align the two 338px vehicle columns and 400px sidebar to the supplied 1870px reference. */
@media(min-width:1500px){.garage-window{--sidebar:400px}.garage-grid{margin-right:calc(var(--sidebar) + 320px)}.garage-caption{padding-left:calc((100% - 1250px)/2)}}
@media(max-width:1150px){main{padding:12px}.garage-window{--sidebar:250px;padding:0 14px}.garage-actions{right:14px}.garage-grid{margin-right:calc(var(--sidebar) + 20px);gap:14px;max-width:700px}.garage-entry,.garage-output{font-size:12px}.garage-value .primary{font-size:12px}.garage-title{font-size:18px}.garage-file-name{font-size:16px}.garage-bop-item{width:200px}}
@media(max-width:820px){.garage-window{padding:0 10px}.garage-actions{position:static;width:auto;display:grid;grid-template-columns:1fr 1fr;overflow:visible;margin:15px 0}.garage-action-panel{padding:12px}.garage-actions>.garage-tech,.garage-sidebar-bottom{align-self:end}.garage-grid{height:auto;min-height:420px;max-height:65vh;margin:0;max-width:none;padding-right:5px}.garage-notes{height:auto;min-height:300px;margin:0}.garage-caption{margin:0}.garage-title #garage-source{display:none}.garage-tabs button{min-width:95px;font-size:16px;padding:8px 13px}.garage-bottom{margin-bottom:10px;flex-wrap:wrap}.garage-apply{width:100%}.garage-bop{width:100%}.garage-bop-item{flex:1;min-width:180px}.garage-title{font-size:16px;align-items:flex-start;padding:10px 0}.garage-file-name{font-size:14px}.garage-window{min-height:600px}}
@media(max-width:540px){main{padding:5px}.garage-window{border-radius:9px}.garage-grid{gap:14px 10px}.garage-entry{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) 12px;font-size:10px;gap:3px}.garage-value .primary{font-size:11px}.garage-output{grid-template-columns:1.3fr 1fr 12px;font-size:10px;gap:3px}.garage-card h2{font-size:11px;padding:5px}.garage-actions{grid-template-columns:1fr}.garage-rear{width:70%}}
@media print{.garage-actions,.garage-tabs,.garage-caption,.garage-bottom,.reader-drawer{display:none!important}.garage-window{border:0;box-shadow:none;color:#111;background:white;min-height:0}.garage-grid{height:auto;max-height:none;margin:0;overflow:visible;display:grid;color:#111}.garage-value .primary,.garage-label{color:#111}.garage-card h2{color:#111;background:#eee}.garage-details>summary{display:none}.garage-notes{margin:0;height:auto;min-height:0}}
</style>
<main id="app-main"><div id="garage-window" class="garage-window"><div id="garage-tools" class="garage-tools" hidden>
<div class="garage-title"><span class="garage-wrench" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M14 3a6 6 0 0 0-7 7l-5 7a2 2 0 0 0 5 3l6-7a6 6 0 0 0 8-7l-4 4-4-4 3-3z"/></svg></span><span><strong>Garage</strong> Setup: <b id="garage-file-name" class="garage-file-name"></b></span><span id="garage-source"></span></div>
<nav class="garage-tabs" aria-label="Navigazione garage"><button id="garage-tires" aria-pressed="false">TIRES</button><button id="garage-chassis" aria-pressed="false">CHASSIS</button><button id="garage-notes" aria-pressed="false">NOTES</button></nav>
<div class="garage-caption" id="garage-caption"></div></div>
<div id="garage-alert" class="garage-alert" role="alert" hidden></div><section class="garage-grid" id="garage-grid" aria-label="Regolazioni per area del garage" hidden></section><section class="garage-notes" id="garage-notes-content" hidden></section>
<aside class="garage-actions">
<div class="garage-action-panel garage-pref"><h3>Preferences</h3><div class="garage-action-buttons"><button id="garage-metric" type="button"></button><button id="garage-autoload" type="button" disabled>Auto-load setups for this car</button></div></div>
<div class="garage-action-panel"><h3 id="garage-file-title">File Actions</h3><div class="garage-action-buttons"><button id="garage-official" type="button" disabled>Official Setups</button><button id="garage-load-a" class="primary-load" type="button">My Setups</button><button id="garage-shared" type="button" disabled>Shared Setups</button><div class="garage-file-row"><button id="garage-share" disabled>Share</button><button id="garage-export">Export CSV</button><button id="garage-save" disabled>Save</button><button disabled>Delete</button></div></div><details class="garage-more"><summary>Confronto e strumenti offline</summary><div class="garage-action-buttons"><button id="garage-load-b" type="button"></button><button id="garage-clear-a" type="button"></button><button id="garage-clear-b" type="button"></button><button id="garage-demo" type="button">DEMO · SYNTHETIC</button><button id="garage-all" aria-pressed="true">Tutte le regolazioni</button><button id="garage-load-sdk" type="button">Importa snapshot SDK JSON</button><input id="garage-sdk-file" type="file" accept=".json,application/json" hidden><button id="garage-return-sto" type="button" hidden>Torna ai file STO</button></div></details></div>
