<!doctype html>
<html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'none'; base-uri 'none'; form-action 'none'">
<title>STO Explorer · Garage</title>
<style>
:root{color-scheme:dark;font:14px system-ui,sans-serif;color:#e8e9ee;background:#111218}*{box-sizing:border-box}body{margin:0}main{max-width:2000px;margin:auto;padding:24px}button,select{font:inherit;background:#292c38;color:#eee;border:1px solid #494d60;border-radius:7px;padding:9px 13px}button{cursor:pointer}button:hover{border-color:#dfc772}button:disabled{opacity:.4;cursor:default}button:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid #efd475;outline-offset:3px}.topbar{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:22px}.brand{margin-right:auto}h1{font-size:24px;margin:0 0 3px}.subtitle,footer,.caption,.file-meta{color:#a6a9b9;font-size:12px}.language{display:flex;gap:8px;align-items:center}.actions{display:flex;gap:8px;flex-wrap:wrap}.primary{border-color:#c8ab55;background:#51472c}.garages{display:grid;grid-template-columns:minmax(0,1fr);gap:18px;align-items:start}.garages.dual{grid-template-columns:repeat(2,minmax(0,1fr))}.garage-pane{min-width:0;background:#1a1b23;border:1px solid #363844;border-radius:12px;overflow:hidden}.pane-head{padding:18px 20px;border-bottom:1px solid #363844;display:flex;align-items:start;gap:12px;flex-wrap:wrap}.pane-title{flex:1;min-width:120px}.pane-title h2{font-size:16px;overflow-wrap:anywhere;margin:0 0 5px}.pane-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.pane-actions button,.pane-actions select{padding:7px 10px;font-size:12px}.tabs{display:flex;gap:4px;overflow-x:auto;padding:10px 16px;border-bottom:1px solid #363844}.tabs button{white-space:nowrap;background:transparent;border-color:transparent}.tabs button[aria-selected="true"]{background:#3c3522;border-color:#af954c;color:#f2d97c}.caption{padding:12px 20px;margin:0;line-height:1.6}.garage-body{padding:0 18px 18px;min-height:180px;overflow-x:auto}.native-wrap{overflow:auto}.reference-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:14px}.reference-card{background:#21232d;border:1px solid #383b49;border-radius:8px;padding:14px}.reference-card h3{font-size:13px;color:#ead481;margin:0 0 10px}.value-row{display:grid;grid-template-columns:1fr auto;gap:10px;padding:9px 0;border-top:1px solid #343644}.value-row .value{font-variant-numeric:tabular-nums;font-weight:650}.value-row small{display:block;color:#9398ac;font:11px ui-monospace,monospace;margin-top:4px;overflow-wrap:anywhere}.empty{padding:65px 24px;text-align:center;line-height:1.8;color:#a6a9b9}.empty h2{color:#eee;font-size:20px;margin:0 0 10px}.empty button{margin-top:15px}.raw-details{margin:0 20px 18px;padding-top:12px;border-top:1px solid #363844}.raw-details summary{cursor:pointer;color:#a6a9b9;font-size:12px}.raw-details pre,.setup-notes{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.7 ui-monospace,monospace}.raw-details pre{max-height:340px;overflow:auto}footer{padding:20px 0;line-height:1.6}.alert{padding:14px 18px;background:#442a30;border:1px solid #81505a;border-radius:7px;white-space:pre-wrap;margin-bottom:15px}[hidden]{display:none!important}
@media(max-width:1000px){.garages.dual{grid-template-columns:minmax(0,1fr)}}@media(max-width:600px){main{padding:14px}.topbar{gap:12px}.actions{width:100%;order:3}.pane-head{padding:14px}.brand h1{font-size:21px}.language select{max-width:110px}}@media print{.topbar,.pane-actions,.raw-details,footer{display:none}.garages.dual{display:block}.garage-pane{break-after:page}}
</style>
<main><header class="topbar"><div class="brand"><h1>STO Explorer</h1><div class="subtitle">Garage · offline · sola lettura</div></div><div class="actions"><button id="open-main" class="primary">Apri setup</button><button id="open-second">Affianca un setup</button><button id="demo">Demo sintetica</button></div><label class="language">Lingua<select id="language"><option value="en">English</option><option value="it">Italiano</option></select></label></header>
<div id="boot-error" class="alert" role="alert">Avvio del Garage…</div><noscript>JavaScript is required. This viewer works offline.</noscript>
<input id="file-main" type="file" accept=".sto" hidden><input id="file-second" type="file" accept=".sto" hidden>
<div id="garages" class="garages"></div>
<footer>STO Reader 0.4 · Nessun file viene modificato o inviato online. I valori calcolati dal simulatore restano indisponibili.</footer></main>
<script>/* Assembled locally. */</script></html>
